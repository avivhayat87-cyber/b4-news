{
  "name": "b4-news",
  "private": true,
  "description": "B4 NEW'S: public site, mobile app, API and newsroom CMS",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,cms -c red,blue,magenta \"npm run dev -w @b4/api\" \"npm run dev -w @b4/web\" \"npm run dev -w @b4/admin\"",
    "dev:api": "npm run dev -w @b4/api",
    "dev:web": "npm run dev -w @b4/web",
    "dev:cms": "npm run dev -w @b4/admin",
    "dev:app": "npm run start -w @b4/mobile",
    "worker": "npm run worker -w @b4/api",
    "db:generate": "npm run generate -w @b4/db",
    "db:migrate": "npm run migrate -w @b4/db",
    "db:seed": "npm run seed -w @b4/db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:check": "npm run check -w @b4/db",
    "check": "npm run typecheck -w @b4/shared -w @b4/db -w @b4/api -w @b4/web -w @b4/admin && npm test -w @b4/shared -w @b4/api --if-present && npm run db:check",
    "live": "node scripts/live.mjs",
    "release": "node scripts/live.mjs release"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2"
  }
}
