# Backend base URL. Leave empty to run the site on built-in sample data.
API_URL=
# e.g. API_URL=http://localhost:8000/api/v1

# Public origin of the site (canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the backend sends in the x-revalidate-secret header after publishing.
REVALIDATE_SECRET=change-me

# Image CDN hosts for next/image, comma-separated.
IMAGE_HOSTS=
