# Copy to .env and adjust. Every value has a safe local default except where noted.

# Where to listen
HOST=127.0.0.1
PORT=4000

# Empty = embedded PostgreSQL in <repo>/.data/b4 (no install needed).
# Production: postgres://user:password@host:5432/b4
DATABASE_URL=

# Sites allowed to call the API with cookies (comma-separated, exact origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3000

# REQUIRED in production: a long random string (used to hash IPs and sign-in codes)
HASH_PEPPER=

# Images: base URL of the media CDN (e.g. https://media.example.co.il)
MEDIA_BASE_URL=

# Email for sign-in codes and newsletter confirmation. Empty = codes are printed to the console.
SMTP_URL=
MAIL_FROM=B4 NEW'S <no-reply@example.co.il>

# Fill the local database with sample articles on start (development only)
SEED_SAMPLE_CONTENT=true

# Behind a load balancer / reverse proxy (production)
TRUST_PROXY=false
