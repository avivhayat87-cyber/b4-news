# Copy to .env and adjust. Every value has a safe local default except where noted.

# Where to listen
HOST=127.0.0.1
PORT=4000
# This API's public origin (media links, development sample sites)
PUBLIC_API_URL=http://localhost:4000

# Empty = embedded PostgreSQL in <repo>/.data/b4 (no install needed).
# Production: postgres://user:password@host:5432/b4
DATABASE_URL=

# Sites allowed to call the API with cookies (comma-separated, exact origins): site, CMS, app web build
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
PUBLIC_SITE_URL=http://localhost:3000

# REQUIRED in production: a long random string (used to hash IPs and sign-in codes)
HASH_PEPPER=

# REQUIRED in production: 32 random bytes, base64 (openssl rand -base64 32). Encrypts the API keys
# and tokens entered in the CMS (Settings > connections). Keep it stable: changing it makes them unreadable.
SECRETS_KEY=

# Images and videos. local = files in MEDIA_DIR, served by this API at <PUBLIC_API_URL>/media.
# r2 = a Cloudflare R2 bucket (the cloud); MEDIA_BASE_URL is then the bucket's public https
# address (e.g. https://media.b4news.co.il) and the R2_* values are required.
MEDIA_STORAGE=local
MEDIA_DIR=
MEDIA_BASE_URL=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email for sign-in codes, newsletter and developer notifications. Empty = printed to the console.
SMTP_URL=
MAIL_FROM=B4 NEW'S <no-reply@example.co.il>

# Fill the local database with sample articles on start (development only)
SEED_SAMPLE_CONTENT=true

# Behind a load balancer / reverse proxy (production)
TRUST_PROXY=false

# --- Background jobs ---------------------------------------------------------
# inline = this process runs the jobs (default). off = run `npm run worker` separately (needs PostgreSQL).
WORKER=inline
WORKER_CONCURRENCY=3

# --- AI ----------------------------------------------------------------------
# Easiest: enter the keys in the CMS (Settings > connections). Values here are a fallback.
# Without keys, development simulates the AI and draws placeholder images; production refuses.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
# Images: Google Gemini (key from aistudio.google.com). The editor chooses from 3 quick
# drafts (IMAGE_PREVIEW_MODEL, 1K); only the chosen one is redrawn with IMAGE_MODEL at
# IMAGE_SIZE (1K, 2K or 4K). Story images use IMAGE_MODEL too.
GEMINI_API_KEY=
IMAGE_PREVIEW_MODEL=gemini-3.1-flash-lite-image
IMAGE_MODEL=gemini-nano-banana-2.1
IMAGE_SIZE=2K
# Draw the first article image drafts automatically after the AI rewrite
AUTO_IMAGES=true

# --- Scraping ----------------------------------------------------------------
SCRAPER_USER_AGENT=B4NewsBot/1.0 (+https://b4news.co.il/bot)
# Development only: allow fetching localhost (the sample sites). Defaults to on in development.
SCRAPER_ALLOW_PRIVATE=
DEV_FIXTURES=

# --- Publishing --------------------------------------------------------------
# Same value as the site's REVALIDATE_SECRET (required in production, 16+ characters)
REVALIDATE_SECRET=
# Defaults to <PUBLIC_SITE_URL>/api/revalidate
SITE_REVALIDATE_URL=
META_GRAPH_VERSION=v23.0

# Social network tokens: enter them in the CMS (Settings > connections). Optional fallback here,
# one variable per account, named SOCIAL_SECRET_<the account's secret name>.
# SOCIAL_SECRET_FACEBOOK_PAGE=   page access token
# SOCIAL_SECRET_INSTAGRAM=       token with instagram_content_publish
# SOCIAL_SECRET_TELEGRAM_BOT=    bot token (the bot must be an admin of the channel)
