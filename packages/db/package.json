    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@b4/shared": "*",
    "@electric-sql/pglite": "^0.3.0",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.0"
