# The nightly backup of the live database: kept on the server (the last 10 backups) and, when
# R2_BACKUP_BUCKET is set in live.env, also outside it.
[Unit]
Description=B4 NEWS nightly backup
After=postgresql.service

[Service]
Type=oneshot
User=b4
Environment=B4_LIVE_HOME=/srv/b4/live
WorkingDirectory=/srv/b4/repo
ExecStart=/usr/bin/node /srv/b4/repo/scripts/live.mjs backup nightly
KillMode=process
TimeoutStartSec=1800
